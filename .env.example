# Copy to .env and fill in. Never commit .env.

# St. Louis Fed (FRED) — free, register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: Riksbank SWEA works keyless (5 requests/minute); a registered key raises the quota.
RIKSBANK_API_KEY=

# Optional: World Bank, OECD, IMF SDMX endpoints don't require keys.
# Optional: BIS Stats — public, no key.
# Optional: WID.world — public, no key.

# Optional response-cache locations for the larger official-source pulls.
DALIO_IMF_BOP_CACHE=data/cache/imf_bop
DALIO_IMF_PIP_CACHE=data/cache/imf_pip
DALIO_IMF_DIP_CACHE=data/cache/imf_dip
DALIO_QPSD_CACHE=data/cache/worldbank_qpsd
DALIO_SCB_FINANCIAL_ACCOUNTS_CACHE=data/cache/scb_financial_accounts
DALIO_MONEY_LIQUIDITY_CACHE=data/cache/money_liquidity
DALIO_SHADOW_LIQUIDITY_CACHE=data/cache/shadow_liquidity
DALIO_PINK_SHEET_CACHE=data/cache/worldbank_commodities
# Durable source evidence, unlike the disposable response caches above.
DALIO_PINK_SHEET_ARTIFACTS=data/artifacts/worldbank_commodities
DALIO_MONEY_LIQUIDITY_ARTIFACTS=data/artifacts/money_liquidity
DALIO_SHADOW_LIQUIDITY_ARTIFACTS=data/artifacts/liquidity_frontier
DALIO_LIQUIDITY_BRIEF_DIR=data/snapshots
DALIO_REPORT_CANDIDATES=data/reference/report_claim_candidates.json
DALIO_REPORT_REVIEW_DIR=data/review
DALIO_COMMUNICATION_PILOT_MANIFEST=data/reference/communication_pilot_events.json
DALIO_COMMUNICATION_RIGHTS_REVIEW_DIR=data/review

# Database location (defaults to data/dalio.db)
DALIO_DB_PATH=data/dalio.db
